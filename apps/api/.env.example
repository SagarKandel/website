# Backend Environment Variables
# Copy this to .env and fill in your values

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/sagar_portfolio

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this

# Email (Gmail SMTP — use App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password

# Where to send new lead notifications
NOTIFY_EMAIL=sagar@sagarkandel.com

# Admin credentials (used in seed)
ADMIN_EMAIL=admin@sagarkandel.com
ADMIN_PASSWORD=change-me-strong-password-2024!

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
