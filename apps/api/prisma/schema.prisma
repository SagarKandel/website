generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PageView {
  id               String   @id @default(cuid())
  page             String   @default("/")
  referrer         String?
  userAgent        String?
  ip               String?
  country          String?
  city             String?
  device           String?  // mobile | desktop | tablet
  browser          String?
  os               String?
  screenResolution String?
  language         String?
  sessionId        String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([country])
  @@index([page])
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    LeadStatus @default(NEW)
  notes     String?
  ip        String?
  country   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([email])
}

model ResumeDownload {
  id        String   @id @default(cuid())
  ip        String?
  country   String?
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
}

enum LeadStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  longDesc    String?
  tech        String[] // array of tech tags
  github      String?
  demo        String?
  image       String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model Experience {
  id          String   @id @default(cuid())
  company     String
  role        String
  startDate   String   // e.g. "Jan 2022"
  endDate     String?  // null = present
  description String
  tech        String[]
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String   // e.g. "Networking", "Cloud", "Scripting"
  level     Int      @default(80) // 0-100
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String   // markdown
  tags        String[]
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([slug])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ActiveSession {
  sessionId   String   @id
  page        String
  lastSeen    DateTime @default(now())
  country     String?
  device      String?

  @@index([lastSeen])
}
